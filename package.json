{
  "name": "@cycjimmy/simulate-chatting",
  "type": "module",
  "version": "3.0.0",
  "description": "simulate chatting ui",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/simulate-chatting#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/simulate-chatting.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/simulate-chatting/issues"
  },
  "keywords": [
    "SimulateChat",
    "swiper"
  ],
  "sideEffects": [
    "**/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/simulate-chatting.esm.js",
      "default": "./dist/simulate-chatting.esm.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/simulate-chatting.esm.js",
  "module": "dist/simulate-chatting.esm.js",
  "browser": "dist/simulate-chatting.umd.min.js",
  "unpkg": "dist/simulate-chatting.umd.min.js",
  "jsdelivr": "dist/simulate-chatting.umd.min.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "dev": "vite",
    "build": "trash dist && npm run build:types && npm run build:esm && npm run build:umd && npm run build:umd:min",
    "build:types": "tsc -p tsconfig.build.json",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "build:deployment": "vite build --mode deployment",
    "package": "trash .release && npm run build && node tasks/copyFiles.ts && node tasks/handlePackageJson.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cycjimmy/awesome-js-funcs": "^5.0.0",
    "@cycjimmy/sass-lib": "^5.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cycjimmy/config-lib": "^4.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.15.0",
    "fs-extra": "^11.4.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "sass": "^1.106.0",
    "stylelint": "^18.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "swiper": "^12.0.1",
    "terser": "^5.51.2",
    "trash-cli": "^7.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "stylelint-order": "^8.1.3"
  }
}
